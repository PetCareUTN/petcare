PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=petcare
DATABASE_USER=petcare_user
DATABASE_PASSWORD=change_me

# En produccion (Railway) la base se conecta con una unica URL en vez de las
# cinco variables de arriba. Si DATABASE_URL esta definida, tiene prioridad.
# DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Los Postgres administrados exigen TLS con certificado propio. Poner en true
# SOLO en staging/produccion: el Postgres local y el de CI no hablan TLS.
DATABASE_SSL=false

# El servidor de Railway corre en UTC. Sin esto, el recordatorio de vacunas de
# las 8 AM (RecordatoriosVacunasService) sale a las 5 AM hora argentina.
TZ=America/Argentina/Cordoba

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Origen permitido para CORS (frontend web Angular en desarrollo).
# Acepta varios separados por coma, sin barra final:
# CORS_ORIGIN=https://petcare.vercel.app,https://www.petcare.com.ar
CORS_ORIGIN=http://localhost:4200

# Brevo (envío de mails: recuperación de contraseña, alta asistida de dueño).
# Sin esto, esos flujos fallan con "Please provide 'apiKey'..." al intentar enviar.
BREVO_API_KEY=change_me
MAIL_FROM=change_me@example.com

# Client ID "Web application" del proyecto PetCare en Google Cloud (NO el de
# Android y NO el client secret). Es contra este valor que se valida el token que
# manda la app al entrar con Google. Sin esto, /auth/google falla.
# No es un secreto: es el mismo valor que viaja dentro de la app en
# mobile-android/app/src/main/res/values/google.xml. Ver docs/ingreso-con-google.md
GOOGLE_CLIENT_ID=669262981079-6su9g7iqegsi3cn8efn4dmr9bsjoch4u.apps.googleusercontent.com

# API key de Google Geocoding (Geocoding API habilitada en Google Cloud).
# Sin esto, GeocodingService omite la geocodificación y los registros de
# veterinarios/prestadores se guardan igual, pero sin latitud/longitud.
GOOGLE_GEOCODING_API_KEY=change_me