PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=petcare
DATABASE_USER=petcare_user
DATABASE_PASSWORD=change_me

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Origen permitido para CORS (frontend web Angular en desarrollo).
# Admite varios orígenes separados por coma, por ejemplo para usar localhost
# y un túnel al mismo tiempo:
# CORS_ORIGIN=http://localhost:4200,https://<tu-subdominio>.ngrok-free.app
CORS_ORIGIN=http://localhost:4200

# URL base pública del backend. Sirve de fallback de las URLs de Mercado Pago
# (back_url y webhook) y para armar los links de los archivos subidos
# (matrículas/habilitaciones).
API_URL=http://localhost:3000

# --- Mercado Pago: URLs públicas (UN solo túnel, el del backend) ---
# Mercado Pago exige que back_url y notification_url sean URLs públicas; con
# localhost responde 400 "Invalid value for back_url, must be a valid URL".
# Con un único túnel (ngrok http 3000) alcanza:
#   back_url = ${API_PUBLIC_URL}/suscripciones/retorno  → 302 al frontend
#   webhook  = ${API_PUBLIC_URL}/suscripciones/webhook
# Sin API_PUBLIC_URL todo cae en localhost:3000 y el checkout real falla.
# Guía paso a paso: docs/suscripciones-mp-local.md
#
# URL pública del backend (obligatoria para probar el checkout):
# API_PUBLIC_URL=https://<tu-subdominio>.ngrok-free.dev
#
# Destino del redirect de retorno (opcional): si no está, se usa el primer
# origen de CORS_ORIGIN (http://localhost:4200).
# FRONTEND_PUBLIC_URL=http://localhost:4200

# Brevo (envío de mails: recuperación de contraseña, alta asistida de dueño).
# Sin esto, esos flujos fallan con "Please provide 'apiKey'..." al intentar enviar.
BREVO_API_KEY=change_me
MAIL_FROM=change_me@example.com

# Client ID "Web application" del proyecto PetCare en Google Cloud (NO el de
# Android y NO el client secret). Es contra este valor que se valida el token que
# manda la app al entrar con Google. Sin esto, /auth/google falla.
# No es un secreto: es el mismo valor que viaja dentro de la app en
# mobile-android/app/src/main/res/values/google.xml. Ver docs/ingreso-con-google.md
GOOGLE_CLIENT_ID=669262981079-6su9g7iqegsi3cn8efn4dmr9bsjoch4u.apps.googleusercontent.com

# API key de Google Geocoding (Geocoding API habilitada en Google Cloud).
# Sin esto, GeocodingService omite la geodificación y los registros de
# veterinarios/prestadores se guardan igual, pero sin latitud/longitud.
GOOGLE_GEOCODING_API_KEY=change_me

# --- Mercado Pago (suscripción mensual de veterinarios, entorno TEST) ---
# Access Token de prueba obtenido de Mercado Pago (developers.mercadopago.com).
# Sin esto, POST /suscripciones/suscribirme falla.
MP_ACCESS_TOKEN=change_me
# Public Key (para el checkout si se usa desde el frontend). No es secreta.
MP_PUBLIC_KEY=change_me
# Secret Signature de "Tus integraciones" → Webhooks. Se usa para validar el
# header x-signature de POST /suscripciones/webhook. Sin esto, el webhook se
# procesa igual pero sin verificar firma (no usar en producción).
MP_WEBHOOK_SECRET=change_me
# Solo para pruebas locales con Mercado Pago Test Users.
# En producción no configurar esta variable.
# MP_PAYER_EMAIL=test@testuser.com
# Monto y moneda de la cuota mensual (provisorio; cambiar cuando se cierre
# el precio definitivo).
SUSCRIPCION_MONTO=1000
SUSCRIPCION_MONEDA=ARS
# Días de gracia tras un pago fallido antes de bloquear al veterinario.
SUSCRIPCION_GRACIA_DIAS=3