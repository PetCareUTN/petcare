<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante de debug: igual que la de release, pero permitiendo HTTP plano,
  porque el backend local (10.0.2.2:3000) no habla HTTPS.

  Este archivo pisa al de src/main en la variante debug. La configuracion de red
  tiene prioridad sobre android:usesCleartextTraffic del manifest, asi que el
  permiso de texto plano tiene que estar aca y no alcanza con el del manifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
