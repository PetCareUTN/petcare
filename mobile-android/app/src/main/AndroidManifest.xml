<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo para guardar en Descargas en Android 9 (API 28) o anterior;
         en API 29+ se usa MediaStore sin permisos. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Ubicación del usuario para centrar el mapa y ordenar "cerca mío".
         COARSE alcanza para esto; FINE se pide igual porque el sistema en
         algunas versiones prioriza el permiso más específico solicitado. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- ===== Colaboración anónima con la búsqueda de mascotas perdidas (US-30) =====
         El rango minSdk 24 → targetSdk 36 obliga a sostener dos caminos de permisos
         en paralelo. Ver docs/spike-escaneo-ble-segundo-plano.md, punto 2. -->

    <!-- Camino legacy (API 24–30): el escaneo se habilita con estos dos permisos
         normales, y ADEMÁS exige ACCESS_FINE_LOCATION en runtime (ya declarado). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Camino moderno (API 31+). A propósito SIN usesPermissionFlags="neverForLocation":
         ese flag es para apps que escanean sin derivar posición, y acá justamente la
         derivamos. Declararlo filtraría resultados y sería incorrecto. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Escanear con la app cerrada. No se puede pedir en el mismo diálogo que el resto:
         Android obliga a un flujo escalonado y en API 30+ manda al usuario a Ajustes. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Notificación del foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Obligatorio desde API 34, y tiene que coincidir con el foregroundServiceType. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- El escaneo necesita radio BLE, pero no queremos que el Play Store excluya
         dispositivos por la app entera: required=false. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetCare">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PetCare"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Colaboración anónima (US-30). El tipo `location` es obligatorio porque de
             la detección derivamos la ubicación aproximada del detector; con
             `connectedDevice` la detección viajaría sin coordenadas y rompería el
             criterio de aceptación de US-31. -->
        <service
            android:name=".features.ble.service.ServicioEscaneoBle"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>