# Datos para firmar el APK de release. Copiar a keystore.properties, que esta
# gitignoreado, y completar con los valores reales.
#
#   cp keystore.properties.example keystore.properties
#
# NUNCA commitear keystore.properties ni el archivo .jks. Si la keystore se
# pierde, no se puede volver a firmar la misma app: Android trata una app
# firmada con otra clave como una app distinta.
#
# Como generar la keystore (una sola vez para todo el proyecto):
#
#   keytool -genkeypair -v -keystore petcare-release.jks \
#     -alias petcare -keyalg RSA -keysize 2048 -validity 10000
#
# Guardala fuera del repo y pasasela al equipo por un canal privado, junto con
# las contrasenas. Despues hay que registrar su SHA-1 en Google Cloud o el
# ingreso con Google falla solo en release. Ver docs/ingreso-con-google.md.

# Ruta de la keystore, relativa a mobile-android/ o absoluta.
storeFile=../petcare-release.jks

# Contrasena de la keystore.
storePassword=

# Alias de la clave dentro de la keystore (el -alias de arriba).
keyAlias=petcare

# Contrasena de esa clave. Si no pusiste una distinta, es la misma de arriba.
keyPassword=
